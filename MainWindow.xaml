<Window x:Class="FirstWPFApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FirstWPFApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBox x:Name="t1" Text="{Binding ElementName=t2, Path=Text}" FontSize="{Binding ElementName=fontsize, Path=Text}" />
        <TextBox x:Name="t2" Text="{Binding ElementName=t1, Path=Text}" FontSize="{Binding ElementName=fontsize, Path=Text}"/>
        <Slider x:Name="slider1" Maximum="99" Minimum="1" Value="{Binding ElementName=fontsize, Path=Text}"/>
        <Slider x:Name="slider2" Maximum="99" Minimum="1" Value="{Binding ElementName=slider1, Path=Value}" />
        <TextBox x:Name="fontsize" Text="{Binding ElementName=slider1, Path=Value}" MaxLength="2" />
    </StackPanel>
</Window>
